# ─── web 환경 변수 템플릿 ───
# 로컬: .env 로 복사 / 배포: .env.prod (Vercel 프로젝트 Environment Variables 에도 같은 값을 넣는다)
# (.env, .env.prod 는 git 에 올리지 않는다)

# API 서버 주소 — 서버에서만 씀. 브라우저는 /api 로 부르고 Next 가 여기로 프록시
#   로컬: http://localhost:8000 / 배포: Cloud Run 주소 (https://puzzlevoca-api-….asia-northeast3.run.app)
API_URL=http://localhost:8000
# 이 사이트 주소 (canonical, sitemap, OG 이미지 주소에 쓰임)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 검색엔진 소유 확인 (Google Search Console / 네이버 서치어드바이저 의 meta 태그 content 값). 비워두면 태그 없음
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
